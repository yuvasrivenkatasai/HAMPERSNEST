{
  "name": "hampersnest-database",
  "version": "1.0.0",
  "description": "Clean, modular production database schema and migration manager for HampersNest",
  "main": "schema/index.js",
  "scripts": {
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "seed": "knex seed:run",
    "db:sync": "node scripts/sync.js",
    "db:verify": "node scripts/verify.js",
    "test": "node --test tests/schema.test.js"
  },
  "keywords": [
    "knex",
    "migrations",
    "schema",
    "hampersnest",
    "oracle"
  ],
  "author": "HampersNest Engineering",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.6.1",
    "knex": "^3.3.0",
    "oracledb": "^26.0.0"
  }
}
