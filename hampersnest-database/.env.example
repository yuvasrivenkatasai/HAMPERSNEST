# ==============================================================================
# HampersNest Database Project - Environment Configuration
# ==============================================================================
# Supported DB_CLIENT options: better-sqlite3, sqlite3, mysql2, pg, oracledb

NODE_ENV=development

# Database Dialect & Client Engine
DB_DIALECT=oracle
DB_CLIENT=oracledb

# Credentials (Use quotes if passwords contain special characters like #, $, !)
DB_USER="HAMPERSNEST"
DB_PASSWORD="your_password_here"

# Oracle Cloud Autonomous Database Configuration
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME="m7z45z3hgdzijbqt_low"
DB_PROTOCOL=tcp
DB_WALLET_PATH="../hampersnest-backend/wallet"
DB_WALLET_PASSWORD="your_wallet_password_here"

# SQLite Configuration (Default for fast local test/dev)
DB_FILE=./database.sqlite

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_ACQUIRE_TIMEOUT_MS=60000

# Migration & Seed Flags
ENABLE_AUTO_MIGRATION=false
ENABLE_DEV_SEEDS=false
