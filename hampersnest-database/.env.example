# ==============================================================================
# HampersNest Database Project - Production Environment Configuration
# ==============================================================================

NODE_ENV=production

# Database Engine
DB_DIALECT=oracle
DB_CLIENT=oracledb

# Oracle User Credentials
DB_USER="HAMPERSNEST"
DB_PASSWORD="your_password_here"

# Oracle Cloud Autonomous Database Configuration (mTLS via Cloud Wallet)
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME="m7z45z3hgdzijbqt_low"
DB_PROTOCOL=tcp
DB_WALLET_PATH="../hampersnest-backend/wallet"
DB_WALLET_PASSWORD="your_wallet_password_here"
